# Copy to .env.local and fill in real values. Never commit .env.local or
# any file containing real secrets — see lib/security/env.ts, which
# refuses to boot the app if any of these are missing or malformed.

# Supabase project URL and public anon key (safe to expose to the browser
# — RLS is what makes the anon key safe, see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. SERVER-ONLY. Bypasses RLS. Never expose to the
# browser, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret (32+ chars) used to HMAC assessment access tokens before
# storing their digest (lib/security/token.ts). Generate with, e.g.:
#   openssl rand -base64 32
# Rotating this pepper invalidates every previously issued assessment link.
ASSESSMENT_TOKEN_PEPPER=replace-with-a-random-32+-character-secret

# Pilot-only. Leave unset (or "false") for any deployment that might serve
# a real client — this is the safe default. Set to exactly "true" ONLY in
# a controlled pilot environment: it reveals the "pilot fixture tag"
# control on the admin Run Analysis screen, letting an attorney exercise
# the synthetic/fixture document-extraction path (no live AI provider
# exists yet) through the real browser UI. See PILOT_VALIDATION_PLAN.md
# and ATTORNEY_PILOT_START_HERE.md.
PILOT_SYNTHETIC_MODE_ENABLED=false
